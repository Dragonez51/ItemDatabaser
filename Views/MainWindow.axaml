<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ItemDatabaser.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="using:ItemDatabaser.Helpers"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500"
        Width="800" Height="500"
        x:Class="ItemDatabaser.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="ItemDatabaser"
        WindowStartupLocation="CenterOwner">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Panel>
        <Grid RowDefinitions="35, 1, *">
            <Menu Grid.Row="0">
                <MenuItem Header="_File">
                    <MenuItem Header="_Export" Click="Export_Click"/>    
                    <MenuItem Header="_Import" Click="Import_Click"/>    
                </MenuItem>
                <MenuItem Header="_Database">
                    <MenuItem Header="_Validate" Click="Database_Validate"/>
                </MenuItem>
            </Menu>
            <GridSplitter Grid.Row="1" Height="1" IsEnabled="False" Background="AliceBlue"/>
            <Grid Grid.Row="2" ColumnDefinitions="*, 3, 3*">
                <UserControl HorizontalAlignment="Stretch" Grid.Column="0" Content="{Binding Structure}"/>
                <GridSplitter Grid.Column="1" Width="5" Background="AliceBlue"/>
                <UserControl HorizontalAlignment="Stretch" Grid.Column="2" Content="{Binding Inspector}"/>
            </Grid>
        </Grid>

        <ItemsControl   ItemsSource="{Binding NotificationService.Notifications}" 
                        HorizontalAlignment="Center" VerticalAlignment="Top"
                        Margin="16" MaxWidth="360"
                        >
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Panel Classes="Notification">
                        <Border Classes.Notification="True" Classes.info="{Binding IsInfo}" Classes.ok="{Binding IsOk}" Classes.error="{Binding IsError}">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Text="{Binding Message}" 
                                Classes="Notification" 
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                TextAlignment="Center"
                                />
                                <Button Grid.Column="1"
                                Content="x"
                                Foreground="RED"
                                Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).NotificationService.DismissCommand}"
                                CommandParameter="{Binding}"
                                />
                            </Grid>
                        </Border>
                    </Panel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Panel>
</Window>
