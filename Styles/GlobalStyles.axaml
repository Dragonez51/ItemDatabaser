<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        >
    <Design.PreviewWith>
        <Border Padding="20" Background="#000">
            <Border Classes="Base">
                <Grid Classes="DataGrid" ColumnDefinitions="*, *">
                    <TextBlock Grid.Column="0" Foreground="#fff" Text="Column:0 Row:0"/>
                    <TextBlock Grid.Column="1" Foreground="#fff" Text="Column:1 Row:0"/>
                </Grid>
            </Border>
        </Border>
    </Design.PreviewWith>

    <Style Selector="Border.Base">
        <Setter Property="BorderBrush" Value="AliceBlue"/>
        <Setter Property="BorderThickness" Value="3"/>
        <Setter Property="Padding" Value="3"/>
        <Setter Property="CornerRadius" Value="3"/>
    </Style>

    <Style Selector="Grid.DataGrid">
        <!-- <Setter Property="Background" Value="Red"/> -->
        <!-- <Setter Property="" Value=""/> -->
    </Style>

    <Style Selector="Image.ButtonImage">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
    </Style>
</Styles>