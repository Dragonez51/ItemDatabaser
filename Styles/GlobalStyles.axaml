<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        >
    <Design.PreviewWith>
        <Border Padding="20" Background="#000">
            <Border Classes="Base">
                <Grid Classes="DataGrid" ColumnDefinitions="*, *" RowDefinitions="*,*">
                    <TextBlock Grid.Column="0" Grid.Row="0" Foreground="#fff" Text="C:0 R:0"/>
                    <TextBlock Grid.Column="1" Grid.Row="0" Foreground="#fff" Text="C:1 R:0"/>
                    <TextBlock Grid.Column="0" Grid.Row="1" Foreground="#fff" Text="C:0 R:1"/>
                    <TextBlock Grid.Column="1" Grid.Row="1" Foreground="#fff" Text="C:1 R:1"/>
                </Grid>
            </Border>
        </Border>
    </Design.PreviewWith>

    <Style Selector="Border.Base">
        <Setter Property="BorderBrush" Value="AliceBlue"/>
        <Setter Property="BorderThickness" Value="3"/>
        <Setter Property="Padding" Value="3"/>
        <Setter Property="CornerRadius" Value="3"/>
    </Style>
    <Style Selector="Border.Notification">
        <Setter Property="BorderThickness" Value="3"/>
        <Setter Property="Padding" Value="3"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Background" Value="#df1f52ff"/>
            <Style Selector="^.info">
                <Setter Property="BorderBrush" Value="#FF00A1FF"/>    
            </Style>
            <Style Selector="^.ok">
                <Setter Property="BorderBrush" Value="#FF00FF1A"/>    
            </Style>
            <Style Selector="^.error">
                <Setter Property="BorderBrush" Value="#FFFF1A00"/>    
            </Style>
    </Style>

    <Style Selector="Grid.DataGrid">
        <!-- <Setter Property="Background" Value="Red"/> -->
    </Style>

    <Style Selector="Image.ButtonImage">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
    </Style>

    <Style Selector="TextBlock.Notification">
        <Setter Property="Foreground" Value="AliceBlue"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Margin" Value="5"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>

    <Style Selector="Panel.Notification">
        <Style.Animations>
            <Animation Duration="0:0:0.3" IterationCount="1">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0.0"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1.0"/>
                </KeyFrame>
            </Animation>
            <Animation Duration="0:0:0.3" Delay="0:0:2.8" IterationCount="1">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="1.0"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="0.0"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>    
    </Style>
</Styles>