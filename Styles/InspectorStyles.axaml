<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ds="using:ItemDatabaser.DataStructures"
        >

   <Style Selector="Grid.DataGrid">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <!-- <Setter Property="HorizontalAlignment" Value="Stretch"/> -->
   </Style>

   <Style Selector="TextBlock.Header">
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="MinWidth" Value="100"/>
   </Style>

   <Style Selector="TextBox.NameBox">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="BorderBrush" Value="#ff00afff"/>
      <Style Selector="^:focus /template/ Border">
         <Setter Property="BorderBrush" Value="#ff00afff"/>
      </Style>
   </Style>
   <Style Selector="TextBox.ValueBox">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
   </Style>
   <Style Selector="TextBox.Validate">
      <Setter Property="BorderBrush" Value="{Binding $self.((ds:Property)DataContext).Validation}"/>
      <Style Selector="^:focus /template/ Border">
         <Setter Property="BorderBrush" Value="{Binding $self.((ds:Property)DataContext).Validation}"/>
      </Style>
   </Style>

   <Style Selector="ComboBox.TypeBox">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
   </Style>

   <Style Selector="StackPanel.HeaderStackPanel">
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
   </Style>

   <Style Selector="Button.Delete">
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
   </Style>
   <Style Selector="Button.Add">
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
   </Style>
   
   <Style Selector="Image.ButtonImage">
      <Setter Property="Width" Value="16"/>
      <Setter Property="Height" Value="16"/>
   </Style>

   <Style Selector="Border.HeaderBorder">
      <Setter Property="BorderBrush" Value="#ff00afff"/>
      <Setter Property="BorderThickness" Value="3"/>
      <!-- <Setter Property="CornerRadius" Value="3"/> -->
   </Style>
</Styles>
